# Copy this file to .secrets.yaml (gitignored — never commit real values)
# in this same directory. servers.yaml references these by name as
# ${VAR_NAME}; mcp-audit substitutes them at load time.

GITHUB_CLIENT_ID: your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET: your-github-oauth-app-client-secret
NEON_TOKEN: your-neon-api-key
